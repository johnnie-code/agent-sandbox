# Where workspaces live when the local backend is used.
SANDBOX_ROOT=/tmp/agent-sandbox/workspaces
# docker (default) runs every command inside a container. local runs it on this machine and must be
# opted into explicitly, because it gives the calling agent the host's own shell.
SANDBOX_MODE=docker
SANDBOX_IMAGE=node:22-bookworm
# none by default: a cloned repo cannot reach the network, so it cannot exfiltrate anything.
SANDBOX_NETWORK=none
SANDBOX_TIMEOUT_MS=120000
# Only needed by sandbox_push and sandbox_open_pr.
GITHUB_TOKEN=
